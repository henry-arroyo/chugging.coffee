  "blocks": [
    {
      "type": "heading",
      "level": 1,
      "text": "New to the Web?"
    },
    {
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "Welcome! The World Wide Web is a collection of pages linked together. Words that are "
        },
        {
          "type": "text",
          "text": "underlined and blue",
          "marks": [
            "underline"
          ]
        },
        {
          "type": "text",
          "text": " are links: click one to go to another page."
        }
      ]
    },
    {
      "type": "heading",
      "level": 2,
      "text": "Getting around"
    },
    {
      "type": "list",
      "ordered": false,
      "items": [
        [
          {
            "type": "text",
            "text": "Back takes you to the page you saw before."
          }
        ],
        [
          {
            "type": "text",
            "text": "Home brings you back to Switchboard."
          }
        ],
        [
          {
            "type": "text",
            "text": "Type an address such as http://chugging.test/ in the Location box and press Enter."
          }
        ],
        [
          {
            "type": "text",
            "text": "Bookmarks remember a page for next time: choose Bookmarks, Add Bookmark."
          }
        ]
      ]
    },
    {
      "type": "heading",
      "level": 2,
      "text": "Why is it slow?"
    },
    {
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "Pages travel down your phone line a little at a time. A 28.8 modem moves about three thousand characters a second, so a page with pictures can take a while. The text usually arrives first."
        }
      ]
    },
    {
      "type": "heading",
      "level": 2,
      "text": "Where to start"
    },
    {
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "Try the "
        },
        {
          "type": "link",
          "href": "/directory.html",
          "text": "directory"
        },
        {
          "type": "text",
          "text": ", see "
        },
        {
          "type": "link",
          "href": "/whats-new.html",
          "text": "what's new"
        },
        {
          "type": "text",
          "text": ", or read today's "
        },
        {
          "type": "link",
          "href": "http://packet.test/",
          "text": "Daily Packet"
        },
        {
          "type": "text",
          "text": "."
        }
      ]
    }
  ]
}
