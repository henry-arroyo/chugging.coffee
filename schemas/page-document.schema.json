{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://chugging.coffee/time-machine/schemas/page-document.schema.json",
  "title": "Page document",
  "description": "A fictional web page built only from safe blocks. No HTML, scripts, event handlers or frames can be expressed.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "pageId", "siteId", "path", "title", "layout", "blocks"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "pageId": { "$ref": "common.schema.json#/$defs/id" },
    "siteId": { "$ref": "common.schema.json#/$defs/id" },
    "path": { "$ref": "common.schema.json#/$defs/sitePath" },
    "title": { "type": "string", "minLength": 1, "maxLength": 120 },
    "layout": {
      "enum": ["plain", "centered", "sidebar", "newspaper", "catalog", "terminal", "homepage", "academic"]
    },
    "theme": { "$ref": "#/$defs/theme" },
    "meta": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "lastModified": { "$ref": "common.schema.json#/$defs/storyDate" },
        "author": { "type": "string", "maxLength": 80 }
      }
    },
    "blocks": {
      "type": "array",
      "minItems": 1,
      "maxItems": 400,
      "items": { "$ref": "#/$defs/block" }
    },
    "transfer": { "$ref": "#/$defs/transferPlan" }
  },
  "$defs": {
    "color": {
      "type": "string",
      "pattern": "^#[0-9a-f]{6}$"
    },
    "theme": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "background": { "$ref": "#/$defs/color" },
        "backgroundAssetId": { "$ref": "common.schema.json#/$defs/assetId" },
        "text": { "$ref": "#/$defs/color" },
        "link": { "$ref": "#/$defs/color" },
        "visitedLink": { "$ref": "#/$defs/color" },
        "font": { "enum": ["serif", "sans", "mono"] }
      }
    },
    "marks": {
      "type": "array",
      "maxItems": 4,
      "uniqueItems": true,
      "items": { "enum": ["bold", "italic", "underline", "code"] }
    },
    "inline": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "text"],
          "properties": {
            "type": { "const": "text" },
            "text": { "type": "string", "minLength": 1, "maxLength": 4000 },
            "marks": { "$ref": "#/$defs/marks" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "href", "text"],
          "properties": {
            "type": { "const": "link" },
            "href": { "$ref": "common.schema.json#/$defs/linkTarget" },
            "text": { "type": "string", "minLength": 1, "maxLength": 400 },
            "marks": { "$ref": "#/$defs/marks" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type"],
          "properties": { "type": { "const": "break" } }
        }
      ]
    },
    "inlines": {
      "type": "array",
      "minItems": 1,
      "maxItems": 200,
      "items": { "$ref": "#/$defs/inline" }
    },
    "blockId": { "$ref": "common.schema.json#/$defs/id" },
    "align": { "enum": ["left", "center", "right"] },
    "cell": {
      "type": "object",
      "additionalProperties": false,
      "required": ["content"],
      "properties": {
        "content": { "$ref": "#/$defs/inlines" },
        "colspan": { "type": "integer", "minimum": 1, "maximum": 12 },
        "align": { "$ref": "#/$defs/align" }
      }
    },
    "block": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "level", "text"],
          "properties": {
            "type": { "const": "heading" },
            "id": { "$ref": "#/$defs/blockId" },
            "level": { "type": "integer", "minimum": 1, "maximum": 4 },
            "text": { "type": "string", "minLength": 1, "maxLength": 200 },
            "align": { "$ref": "#/$defs/align" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "content"],
          "properties": {
            "type": { "const": "paragraph" },
            "id": { "$ref": "#/$defs/blockId" },
            "content": { "$ref": "#/$defs/inlines" },
            "align": { "$ref": "#/$defs/align" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "href", "text"],
          "properties": {
            "type": { "const": "link" },
            "id": { "$ref": "#/$defs/blockId" },
            "href": { "$ref": "common.schema.json#/$defs/linkTarget" },
            "text": { "type": "string", "minLength": 1, "maxLength": 200 },
            "description": { "type": "string", "maxLength": 400 }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "assetId", "alt", "width", "height", "declaredBytes"],
          "properties": {
            "type": { "const": "image" },
            "id": { "$ref": "#/$defs/blockId" },
            "assetId": { "$ref": "common.schema.json#/$defs/assetId" },
            "alt": { "type": "string", "maxLength": 300 },
            "width": { "type": "integer", "minimum": 1, "maximum": 800 },
            "height": { "type": "integer", "minimum": 1, "maximum": 1200 },
            "declaredBytes": { "type": "integer", "minimum": 1, "maximum": 1048576 },
            "align": { "$ref": "#/$defs/align" },
            "href": { "$ref": "common.schema.json#/$defs/linkTarget" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "ordered", "items"],
          "properties": {
            "type": { "const": "list" },
            "id": { "$ref": "#/$defs/blockId" },
            "ordered": { "type": "boolean" },
            "items": {
              "type": "array",
              "minItems": 1,
              "maxItems": 100,
              "items": { "$ref": "#/$defs/inlines" }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type"],
          "properties": {
            "type": { "const": "rule" },
            "id": { "$ref": "#/$defs/blockId" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "rows"],
          "properties": {
            "type": { "const": "table" },
            "id": { "$ref": "#/$defs/blockId" },
            "caption": { "type": "string", "maxLength": 200 },
            "border": { "type": "integer", "minimum": 0, "maximum": 4 },
            "header": {
              "type": "array",
              "minItems": 1,
              "maxItems": 12,
              "items": { "$ref": "#/$defs/cell" }
            },
            "rows": {
              "type": "array",
              "minItems": 1,
              "maxItems": 200,
              "items": {
                "type": "array",
                "minItems": 1,
                "maxItems": 12,
                "items": { "$ref": "#/$defs/cell" }
              }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "text"],
          "properties": {
            "type": { "const": "preformatted" },
            "id": { "$ref": "#/$defs/blockId" },
            "text": { "type": "string", "minLength": 1, "maxLength": 8000 },
            "label": {
              "description": "Accessible description of text art, read instead of the raw characters.",
              "type": "string",
              "maxLength": 300
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "widget"],
          "properties": {
            "type": { "const": "widget" },
            "id": { "$ref": "#/$defs/blockId" },
            "widget": { "$ref": "widget-props.schema.json" }
          }
        }
      ]
    },
    "transferPlan": {
      "description": "Optional authored chunk plan. When absent, the transfer planner derives one chunk per block.",
      "type": "object",
      "additionalProperties": false,
      "required": ["chunks"],
      "properties": {
        "chunks": {
          "type": "array",
          "minItems": 1,
          "maxItems": 400,
          "items": { "$ref": "#/$defs/transferChunk" }
        }
      }
    },
    "transferChunk": {
      "type": "object",
      "additionalProperties": false,
      "required": ["index", "kind", "blockIds", "declaredBytes"],
      "properties": {
        "index": { "type": "integer", "minimum": 0, "maximum": 399 },
        "kind": { "enum": ["text", "image"] },
        "blockIds": {
          "type": "array",
          "minItems": 1,
          "maxItems": 50,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/blockId" }
        },
        "declaredBytes": { "type": "integer", "minimum": 1, "maximum": 1048576 }
      }
    }
  }
}
