{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://chugging.coffee/time-machine/schemas/site-manifest.schema.json",
  "title": "Site manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "siteId", "host", "title", "homePath", "sinceReleaseId", "pages"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "siteId": { "$ref": "common.schema.json#/$defs/id" },
    "host": { "$ref": "common.schema.json#/$defs/host" },
    "title": { "type": "string", "minLength": 1, "maxLength": 80 },
    "homePath": { "$ref": "common.schema.json#/$defs/sitePath" },
    "sinceReleaseId": { "$ref": "common.schema.json#/$defs/releaseId" },
    "pages": {
      "type": "array",
      "minItems": 1,
      "maxItems": 200,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["pageId", "path", "document"],
        "properties": {
          "pageId": { "$ref": "common.schema.json#/$defs/id" },
          "path": { "$ref": "common.schema.json#/$defs/sitePath" },
          "aliases": {
            "type": "array",
            "maxItems": 10,
            "items": { "$ref": "common.schema.json#/$defs/sitePath" }
          },
          "document": {
            "description": "Page document file relative to the manifest.",
            "type": "string",
            "maxLength": 96,
            "pattern": "^pages/[a-z0-9-]+\\.json$"
          }
        }
      }
    }
  }
}
