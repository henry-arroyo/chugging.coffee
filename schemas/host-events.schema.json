{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://chugging.coffee/time-machine/schemas/host-events.schema.json",
  "title": "Typed host event",
  "description": "Events on the host bus between the shell, applications and simulation services.",
  "oneOf": [
    {
      "type": "object", "additionalProperties": false, "required": ["type", "appId"],
      "properties": {
        "type": { "const": "app.launch" },
        "appId": { "$ref": "common.schema.json#/$defs/id" },
        "path": { "$ref": "common.schema.json#/$defs/vfsPath" },
        "address": { "$ref": "common.schema.json#/$defs/linkTarget" }
      }
    },
    {
      "type": "object", "additionalProperties": false, "required": ["type", "windowId"],
      "properties": {
        "type": { "enum": ["window.focused", "window.closed", "window.minimized", "window.restored", "window.maximized"] },
        "windowId": { "$ref": "#/$defs/instanceId" }
      }
    },
    {
      "type": "object", "additionalProperties": false, "required": ["type", "state", "generation"],
      "properties": {
        "type": { "const": "net.state" },
        "state": { "enum": ["offline", "initializing", "dialing", "negotiating", "authenticating", "online", "disconnecting"] },
        "generation": { "$ref": "common.schema.json#/$defs/nonNegativeInt" },
        "error": { "type": "string", "maxLength": 200 }
      }
    },
    {
      "type": "object", "additionalProperties": false, "required": ["type", "requestId", "phase", "bytesDone", "bytesTotal"],
      "properties": {
        "type": { "const": "net.transfer" },
        "requestId": { "$ref": "#/$defs/instanceId" },
        "phase": { "enum": ["queued", "latency", "progress", "complete", "cancelled", "failed"] },
        "bytesDone": { "$ref": "common.schema.json#/$defs/nonNegativeInt" },
        "bytesTotal": { "$ref": "common.schema.json#/$defs/nonNegativeInt" }
      }
    },
    {
      "type": "object", "additionalProperties": false, "required": ["type", "address", "source"],
      "properties": {
        "type": { "const": "nav.request" },
        "address": { "type": "string", "maxLength": 2048 },
        "source": { "enum": ["netscape", "aol"] }
      }
    },
    {
      "type": "object", "additionalProperties": false, "required": ["type", "paths"],
      "properties": {
        "type": { "const": "vfs.changed" },
        "paths": { "type": "array", "minItems": 1, "maxItems": 100, "items": { "$ref": "common.schema.json#/$defs/vfsPath" } }
      }
    },
    {
      "type": "object", "additionalProperties": false, "required": ["type", "mode"],
      "properties": {
        "type": { "const": "storage.status" },
        "mode": { "enum": ["persistent", "temporary", "read-only-other-tab"] },
        "reason": { "enum": ["denied", "quota", "corrupt", "unavailable", "other-tab"] }
      }
    },
    {
      "type": "object", "additionalProperties": false, "required": ["type", "releaseId"],
      "properties": {
        "type": { "const": "release.available" },
        "releaseId": { "$ref": "common.schema.json#/$defs/releaseId" }
      }
    },
    {
      "type": "object", "additionalProperties": false, "required": ["type", "clueId", "releaseId"],
      "properties": {
        "type": { "const": "discovery.recorded" },
        "clueId": { "$ref": "common.schema.json#/$defs/id" },
        "releaseId": { "$ref": "common.schema.json#/$defs/releaseId" }
      }
    },
    {
      "type": "object", "additionalProperties": false, "required": ["type", "soundId"],
      "properties": {
        "type": { "const": "audio.play" },
        "soundId": { "$ref": "common.schema.json#/$defs/assetId" }
      }
    },
    {
      "type": "object", "additionalProperties": false, "required": ["type", "keys"],
      "properties": {
        "type": { "const": "settings.applied" },
        "keys": {
          "type": "array", "minItems": 1, "maxItems": 20, "uniqueItems": true,
          "items": { "enum": ["desktop", "sound", "connection", "accessibility", "clock", "solitaire", "minesweeper"] }
        }
      }
    },
    {
      "type": "object", "additionalProperties": false, "required": ["type", "appId", "message"],
      "properties": {
        "type": { "const": "app.crashed" },
        "appId": { "$ref": "common.schema.json#/$defs/id" },
        "message": { "type": "string", "maxLength": 500 }
      }
    }
  ],
  "$defs": {
    "instanceId": { "type": "string", "pattern": "^[a-z0-9-]{1,64}$" }
  }
}
