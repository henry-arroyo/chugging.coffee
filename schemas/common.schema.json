{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://chugging.coffee/time-machine/schemas/common.schema.json",
  "title": "Shared definitions",
  "$defs": {
    "id": {
      "description": "Stable content identifier. Never reused for a different meaning once published.",
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "assetId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 96,
      "pattern": "^[a-z0-9]+(?:[-.][a-z0-9]+)*$"
    },
    "releaseId": {
      "type": "string",
      "pattern": "^rel-[0-9]{4}$"
    },
    "semver": {
      "type": "string",
      "pattern": "^(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)$"
    },
    "date": {
      "type": "string",
      "pattern": "^[0-9]{4}-(?:0[1-9]|1[0-2])-(?:0[1-9]|[12][0-9]|3[01])$"
    },
    "storyDate": {
      "description": "A fictional in-world date. The world is set in 1995 and may run into 1996.",
      "type": "string",
      "pattern": "^199[56]-(?:0[1-9]|1[0-2])-(?:0[1-9]|[12][0-9]|3[01])$"
    },
    "dateTime": {
      "type": "string",
      "maxLength": 40,
      "pattern": "^[0-9]{4}-(?:0[1-9]|1[0-2])-(?:0[1-9]|[12][0-9]|3[01])T(?:[01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9](?:\\.[0-9]{1,3})?(?:Z|[+-](?:[01][0-9]|2[0-3]):[0-5][0-9])$"
    },
    "host": {
      "description": "A fictional host. Only the reserved .test top-level domain is allowed.",
      "type": "string",
      "maxLength": 40,
      "pattern": "^[a-z0-9](?:[a-z0-9-]{0,30}[a-z0-9])?\\.test$"
    },
    "sitePath": {
      "description": "Absolute path within a fictional site. Segments start with a letter or digit (optionally after ~), so . and .. are impossible.",
      "type": "string",
      "minLength": 1,
      "maxLength": 160,
      "pattern": "^/(?:~?[a-z0-9][a-z0-9_-]*(?:\\.[a-z0-9]+)?/)*(?:~?[a-z0-9][a-z0-9_-]*(?:\\.[a-z0-9]+)?)?$"
    },
    "virtualAddress": {
      "type": "string",
      "maxLength": 256,
      "pattern": "^http://[a-z0-9](?:[a-z0-9-]{0,30}[a-z0-9])?\\.test(?:/(?:~?[a-z0-9][a-z0-9_-]*(?:\\.[a-z0-9]+)?/)*(?:~?[a-z0-9][a-z0-9_-]*(?:\\.[a-z0-9]+)?)?)?(?:#[a-z0-9-]{1,64})?$"
    },
    "aolAddress": {
      "type": "string",
      "maxLength": 64,
      "pattern": "^aol://keyword/[a-z0-9](?:[a-z0-9 ]{0,30}[a-z0-9])?$"
    },
    "linkTarget": {
      "description": "Where a link may point: a registered virtual address, an AOL keyword, a same-site path, or a same-page anchor.",
      "type": "string",
      "maxLength": 256,
      "anyOf": [
        { "$ref": "#/$defs/virtualAddress" },
        { "$ref": "#/$defs/aolAddress" },
        { "$ref": "#/$defs/sitePath" },
        { "pattern": "^#[a-z0-9-]{1,64}$" }
      ]
    },
    "screenName": {
      "description": "Normalized guest screen name: 3-16 ASCII letters, digits and single inner spaces.",
      "type": "string",
      "minLength": 3,
      "maxLength": 16,
      "pattern": "^[A-Za-z0-9]+(?: [A-Za-z0-9]+)*$"
    },
    "vfsPath": {
      "description": "Virtual C: drive path. Shape only; the VFS module performs the authoritative check.",
      "type": "string",
      "minLength": 3,
      "maxLength": 260,
      "pattern": "^C:\\\\(?:[A-Za-z0-9 _.()'-]{1,64}\\\\)*[A-Za-z0-9 _.()'-]{0,64}$",
      "not": { "pattern": "(?:^|\\\\)\\.{1,2}(?:\\\\|$)" }
    },
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "nonNegativeInt": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "card": {
      "description": "Playing card: rank then suit, e.g. AS, 10H, QD.",
      "type": "string",
      "pattern": "^(?:A|[2-9]|10|J|Q|K)[CDHS]$"
    },
    "geometry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["x", "y", "width", "height"],
      "properties": {
        "x": { "type": "integer", "minimum": -4000, "maximum": 4000 },
        "y": { "type": "integer", "minimum": -4000, "maximum": 4000 },
        "width": { "type": "integer", "minimum": 1, "maximum": 4000 },
        "height": { "type": "integer", "minimum": 1, "maximum": 4000 }
      }
    }
  }
}
